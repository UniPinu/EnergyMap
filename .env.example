# Copy to `.env` (git-ignored). Never commit real values.

# ENTSO-E Transparency Platform token (obtained by email from transparency@entsoe.eu, ~3 working days).
# Leave empty until granted; the ENTSO-E ingester (Phase 4) refuses to start without it.
ENTSOE_TOKEN=

# Backend
EMAP_DB_PATH=backend/data/energymap.duckdb
EMAP_HOST=127.0.0.1
EMAP_PORT=8000
EMAP_CORS_ORIGINS=http://localhost:5173

# Frontend (Vite exposes only VITE_* to the browser)
VITE_API_BASE=http://127.0.0.1:8000
